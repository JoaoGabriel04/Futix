generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  GOOGLE
  DISCORD
}

enum RoomStatus {
  OPEN
  LOCKED
  DRAWN
  LIVE
  CANCELED
  FINISHED
}

enum MemberRole {
  PLAYER
  CO_ORGANIZER
  ORGANIZER
}

enum PlayRole {
  LINE
  GOALKEEPER
}

enum MemberStatus {
  PENDING
  CONFIRMED
  WAITLIST
  REJECTED
  LEFT
}

enum WeightLevel {
  REGULAR
  GOOD
  STAR
}

enum WinnerRule {
  ALWAYS
  MAX_2_WINS
}

enum MatchStatus {
  LIVE
  PAUSED
  FINISHED
}

enum MatchEndReason {
  GOALS
  TIME
  MANUAL
}

enum MatchEventType {
  GOAL
  OWN_GOAL
}

model User {
  id                String       @id @default(cuid())
  provider          Provider
  providerId        String
  email             String?
  name              String
  nickname          String?
  phone             String?
  preferredPosition String?
  avatarUrl         String?
  createdAt         DateTime     @default(now())
  members           RoomMember[]
  roomsOwned        Room[]       @relation("Owner")
  weightsGiven      PlayerWeight[] @relation("WeightOwner")
  weightsReceived   PlayerWeight[] @relation("WeightPlayer")

  @@unique([provider, providerId])
}

model Room {
  id               String       @id @default(cuid())
  title            String
  location         String
  startsAt         DateTime
  lineSlots        Int
  teamSize         Int          @default(4)
  goalkeeperSlots  Int          @default(2)
  requireApproval  Boolean      @default(true)
  status           RoomStatus   @default(OPEN)
  ownerId          String
  owner            User         @relation("Owner", fields: [ownerId], references: [id])
  members          RoomMember[]
  invites          Invite[]
  draws            Draw[]
  matches          Match[]
  createdAt        DateTime     @default(now())
  matchMinutes     Int          @default(10)
  winnerRule       WinnerRule   @default(MAX_2_WINS)
  maxStarsPerTeam  Int          @default(3)
  startedAt        DateTime?
  finishedAt       DateTime?
}

model RoomMember {
  id               String       @id @default(cuid())
  roomId           String
  userId           String
  role             MemberRole   @default(PLAYER)
  playRole         PlayRole
  status           MemberStatus @default(PENDING)
  waitlistPosition Int?
  requestedAt      DateTime     @default(now())
  decidedAt        DateTime?
  decidedById      String?
  invitedById      String?
  room             Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId, status, playRole])
}

model Invite {
  id          String    @id @default(cuid())
  roomId      String
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Draw {
  id          String     @id @default(cuid())
  roomId      String
  createdAt   DateTime   @default(now())
  createdById String
  teams       DrawTeam[]
  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model DrawTeam {
  id              String   @id @default(cuid())
  drawId          String
  name            String
  queuePosition   Int?
  consecutiveWins Int      @default(0)
  playerIds       String[]
  draw            Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
}

model PlayerWeight {
  id        String      @id @default(cuid())
  ownerId   String
  playerId  String
  level     WeightLevel @default(GOOD)
  updatedAt DateTime    @updatedAt
  owner     User        @relation("WeightOwner", fields: [ownerId], references: [id])
  player    User        @relation("WeightPlayer", fields: [playerId], references: [id])

  @@unique([ownerId, playerId])
}

model Match {
  id             String          @id @default(cuid())
  roomId         String
  number         Int
  teamAId        String
  teamBId        String
  teamAPlayerIds String[]
  teamBPlayerIds String[]
  limitSeconds   Int
  status         MatchStatus     @default(LIVE)
  startedAt      DateTime
  elapsedSeconds Int             @default(0)
  scoreA         Int             @default(0)
  scoreB         Int             @default(0)
  winnerTeamId   String?
  endReason      MatchEndReason?
  endedAt        DateTime?
  createdById    String
  events         MatchEvent[]
  rotation       Rotation?
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, number])
}

model MatchEvent {
  id          String         @id @default(cuid())
  matchId     String
  type        MatchEventType
  teamId      String
  scorerId    String?
  assistId    String?
  atSecond    Int
  undoneAt    DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  match       Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, undoneAt])
}

model Rotation {
  id         String @id @default(cuid())
  matchId    String @unique
  kind       String
  swaps      Json
  courtAfter Json
  queueAfter Json
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
